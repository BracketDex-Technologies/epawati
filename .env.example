# ePawati Next.js environment example
#
# Keep this file safe to commit. Put real passwords, JWT secrets, Supabase
# service keys, and AuthKey keys only in .env.local or deployment env vars.

# Browser calls stay same-origin by default. This is the main reason the new
# Next app avoids the old cross-site cookie/session problem.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Serverless API route config. The copied backend now runs inside this Next app
# at /api/v1/*, so no old backend URL is required.
NODE_ENV=development
API_GLOBAL_PREFIX=api
SWAGGER_ENABLED=false
PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
PUBLIC_WEB_BASE_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:3000

# Production public URLs:
# NODE_ENV=production
# PUBLIC_API_BASE_URL=https://epawati.samavet.in/api/v1
# PUBLIC_WEB_BASE_URL=https://epawati.samavet.in
# PUBLIC_FRONTEND_URL=https://epawati.samavet.in

# Database: keep using the same Supabase Postgres database.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres
DATABASE_SLOW_QUERY_MS=500

# Auth
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-different-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_NAME=digital_vargani_refresh
AUTH_REFRESH_COOKIE_MAX_AGE_MS=2592000000

# Same-origin Next API can use lax cookies.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Production cookie example:
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=lax

# Supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_STORAGE_BUCKET=digital-vargani
SUPABASE_RECEIPT_BUCKET=digital-vargani-receipts
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# Background jobs / retry queue
REDIS_URL=redis://localhost:6379
CRON_SECRET=replace-with-random-secret-at-least-32-chars
JOB_DRAIN_BATCH_SIZE=10

# AuthKey WhatsApp
AUTHKEY_WHATSAPP_ENABLED=false
AUTHKEY_WHATSAPP_TEMPLATE_TYPE=media
AUTHKEY_API_KEY=replace-with-authkey-api-key
AUTHKEY_WHATSAPP_RECEIPT_WID=replace-with-template-wid
AUTHKEY_WHATSAPP_COUNTRY_CODE=91
AUTHKEY_WHATSAPP_HEADER_FILE_NAME=SAMAVET ePawati
AUTHKEY_WHATSAPP_HEADER_MEDIA_URL=https://example.com/header-image.jpg

# Server-side translation providers. Never expose these through NEXT_PUBLIC_*.
GROQ_API_KEY=
GROQ_TRANSLATION_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_TRANSLATION_MODEL=openrouter/free
