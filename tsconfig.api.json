{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["server/api/src/**/*.ts"],
  "exclude": ["server/api/src/**/*.spec.ts", "server/api/src/**/*.test.ts"]
}
